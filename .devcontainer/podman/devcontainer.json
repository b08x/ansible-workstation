// with SELinux strictly enforced, they might run into issues with workspace volumes failing to mount. 
// If this happens, you can bypass it by adding "--security-opt=label=disable" to your runArgs array, 
// which tells Podman not to apply SELinux labels to the container's processes.
{
    "image": "ghcr.io/ansible/community-ansible-dev-tools:latest",
    "remoteUser": "vscode",
    "updateRemoteUserUID": false,
    "runArgs": [
        "--userns=keep-id",
        "--device=/dev/fuse",
        "--security-opt=unmask=/sys/fs/cgroup",
        "--hostname=ansible-dev-container"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "redhat.ansible",
                "redhat.vscode-redhat-account"
            ]
        }
    }
}