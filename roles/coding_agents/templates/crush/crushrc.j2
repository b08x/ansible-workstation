# crushrc — generated by Ansible coding_agents role
# DO NOT EDIT MANUALLY — override via group_vars/host_vars instead

# Provider configuration
provider add {{ coding_agents_crush_provider }}

# Model selection
model large {{ coding_agents_crush_model_large }}
model small {{ coding_agents_crush_model_small }}

# Permissions
{% for permission in coding_agents_crush_permissions.allow %}
permissions allow {{ permission }}
{% endfor %}

# Skill paths
option skill-path {{ coding_agents_skills_dir }}

# MCP servers
{% for name, config in coding_agents_crush_mcp_servers.items() %}
mcp add {{ name }} {{ config.command }} {{ config.args | join(' ') }}
{% if config.env is defined %}
{% for env_key, env_value in config.env.items() %}
  --env {{ env_key }}="{{ env_value }}"
{% endfor %}
{% endif %}
{% endfor %}
