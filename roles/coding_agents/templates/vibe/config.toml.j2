# config.toml — generated by Ansible coding_agents role
# DO NOT EDIT MANUALLY — override via group_vars/host_vars instead

active_model = "{{ coding_agents_vibe_settings.active_model }}"

enabled_tools = {{ coding_agents_vibe_settings.enabled_tools | to_nice_json }}
disabled_tools = {{ coding_agents_vibe_settings.disabled_tools | to_nice_json }}

skill_paths = {{ coding_agents_vibe_settings.skill_paths | to_nice_json }}

{% if coding_agents_vibe_mcp_servers | length > 0 %}
{% for server in coding_agents_vibe_mcp_servers %}
[[mcp_servers]]
name = "{{ server.name }}"
command = "{{ server.command }}"
args = {{ server.args | to_nice_json }}
{% if server.env is defined %}
{% for env_key, env_value in server.env.items() %}
{{ env_key }} = "{{ env_value }}"
{% endfor %}
{% endif %}

{% endfor %}
{% endif %}
