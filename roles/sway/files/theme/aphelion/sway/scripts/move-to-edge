#!/bin/bash
set -euo pipefail
set -f

op="${1:-}"
swaymsg -t get_tree | jq -r 'recurse(
    .focus[0] as $target
    | (.nodes + .floating_nodes)[]
    | select(.id == $target)
    ) | "\(.type) \(.rect.x) \(.rect.y) \(.rect.width) \(.rect.height) \(.deco_rect.height)"' | {

    x=0
    y=0
    w=0
    h=0
    d=0
    ws_x=0
    ws_y=0
    ws_w=0
    ws_h=0
    found=0
    while read -r line; do
        # shellcheck disable=2086
        set -- $line
        case $1 in
            workspace)
                ws_x=$2
                ws_y=$3
                ws_w=$4
                ws_h=$5
                ;;
            floating_con)
                x=$2
                y=$3
                w=$4
                h=$5
                d=$6
                found=1
                ;;
        esac
    done
    if [ "$found" -eq 0 ]; then
        exit 0
    fi
    case $op in
        l*) x=0; y=$((y - d - ws_y));;
        d*) x=$((x - ws_x)); y=$((ws_h - h - d));;
        u*) x=$((x - ws_x)); y=0;;
        r*) x=$((ws_w - w)); y=$((y - d - ws_y));;
        *) exit 1;;
    esac
    swaymsg "move position $x $y"
}
