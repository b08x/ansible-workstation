(defwidget workspaces []
  (box :class "workspaces-widget"
       :orientation "horizontal"
       :space-evenly false
       :spacing 4
    (button :class "ws-button" :onclick "swaymsg workspace 1" "1")
    (button :class "ws-button" :onclick "swaymsg workspace 2" "2")
    (button :class "ws-button" :onclick "swaymsg workspace 3" "3")
    (button :class "ws-button" :onclick "swaymsg workspace 4" "4")
    (button :class "ws-button" :onclick "swaymsg workspace 5" "5")
    (button :class "ws-button" :onclick "swaymsg workspace 6" "6")
    (button :class "ws-button" :onclick "swaymsg workspace 7" "7")
    (button :class "ws-button" :onclick "swaymsg workspace 8" "8")
    (button :class "ws-button" :onclick "swaymsg workspace 9" "9")
    (button :class "ws-button" :onclick "swaymsg workspace 10" "10")))
