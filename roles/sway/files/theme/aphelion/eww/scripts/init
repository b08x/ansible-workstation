#!/bin/bash
set -euo pipefail

# Ensure Eww daemon is running
if ! pgrep -x eww >/dev/null 2>&1; then
    eww daemon >/dev/null 2>&1 &
    for _ in $(seq 1 20); do
        if eww ping >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
fi

# Ensure default visibility states
eww update sidebar_visible=false powermenu_visible=false >/dev/null 2>&1 || true

# Open primary bottom bar
eww open bottom-bar >/dev/null 2>&1 || true
