# 04-input.conf - Input devices, keyboard layouts, and touchpad behavior
input "type:keyboard" {
    xkb_layout "us"
    xkb_options "ctrl:nocaps"
    repeat_delay 300
    repeat_rate 50
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

input "type:pointer" {
    scroll_factor 1.0
}
