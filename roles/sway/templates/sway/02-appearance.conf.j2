# 02-appearance.conf - Window styling, borders, gaps, and SwayFX effects
font {{ sway_font | default('pango:monospace 10') }}
default_border pixel 2
default_floating_border pixel 2

gaps inner 8
gaps outer 4

{% if sway_compositor | default('sway') == 'swayfx' %}
# SwayFX enhancement settings
corner_radius {{ sway_fx_corner_radius | default(10) }}
blur {{ 'enable' if (sway_fx_blur | default(false) | bool) else 'disable' }}
shadows {{ 'enable' if (sway_fx_shadows | default(true) | bool) else 'disable' }}
shadow_blur_radius 20
shadow_color #00000088
{% endif %}

# Window title alignment
title_align left
