# 10-autostart.conf - Session autostart and bar engine dispatch
exec {
    hash dbus-update-activation-environment 2>/dev/null && \
        dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
}

{% if (sway_bar_engine | default('waybar')) == 'eww' %}
# Autostart Eww daemon and bar widgets
exec_always {
    $eww/init
}
{% endif %}
