# 01-colors.conf - Aphelion color palette definitions for Sway
set $xbg #101319
set $xfg #f4f3ee
set $x0 #101319
set $x1 #ea515d
set $x2 #62c073
set $x3 #ebcb8b
set $x4 #5294e2
set $x5 #c678dd
set $x6 #56b6c2
set $x7 #abb2bf
set $x8 #252a34
set $x9 #ff6c6b
set $x10 #98c379
set $x11 #e5c07b
set $x12 #61afef
set $x13 #d19a66
set $x14 #88c0d0
set $x15 #f4f3ee

# Sway window colors using Aphelion palette
# class                 border  bg      text    ind     child_border
client.focused          $x4     $x4     $xfg    $x4     $x4
client.focused_inactive $x8     $x8     $xfg    $x8     $x8
client.unfocused        $x0     $x0     $x7     $x0     $x0
client.urgent           $x1     $x1     $xfg    $x1     $x1
client.placeholder      $x0     $x0     $x7     $x0     $x0
client.background       $xbg
