[Unit]
Description=Eww Widget Daemon for Sway Session
PartOf=graphical-session.target sway-session.target
After=sway-session.target

[Service]
Type=simple
ExecStart=/usr/bin/eww daemon --no-daemonize
ExecReload=/usr/bin/eww reload
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sway-session.target
