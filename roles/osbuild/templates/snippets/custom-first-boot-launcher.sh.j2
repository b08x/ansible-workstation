#!/bin/bash
# Find a terminal emulator and launch the custom first boot script in it.
for term in xdg-terminal-exec gnome-terminal kitty foot alacritty terminator xterm; do
    if command -v "$term" &>/dev/null; then
        case "$term" in
            xdg-terminal-exec)
                exec xdg-terminal-exec bash -c "sudo /usr/local/sbin/custom-first-boot; echo 'Press Enter to close...'; read"
                ;;
            gnome-terminal)
                exec gnome-terminal -- bash -c "sudo /usr/local/sbin/custom-first-boot; echo 'Press Enter to close...'; read"
                ;;
            kitty)
                exec kitty bash -c "sudo /usr/local/sbin/custom-first-boot; echo 'Press Enter to close...'; read"
                ;;
            foot)
                exec foot bash -c "sudo /usr/local/sbin/custom-first-boot; echo 'Press Enter to close...'; read"
                ;;
            alacritty)
                exec alacritty -e bash -c "sudo /usr/local/sbin/custom-first-boot; echo 'Press Enter to close...'; read"
                ;;
            terminator)
                exec terminator -e "bash -c 'sudo /usr/local/sbin/custom-first-boot; echo Press Enter to close...; read'"
                ;;
            xterm)
                exec xterm -e "bash -c 'sudo /usr/local/sbin/custom-first-boot; echo Press Enter to close...; read'"
                ;;
        esac
    fi
done
