#!/bin/bash
# {{ ansible_managed }}
# First boot configuration dashboard for OSBuild images

set -euo pipefail

# Check if gum is available, fallback to echo if not
GUM=$(command -v gum || true)

function banner() {
    if [ -n "$GUM" ]; then
        $GUM style \
            --foreground 212 --border-foreground 212 --border double \
            --align center --width 60 --padding "1 2" \
            "{{ ansible_distribution | upper }} WORKSTATION BUILDER" "First Boot Configuration" || \
        echo "=== {{ ansible_distribution | upper }} WORKSTATION BUILDER - First Boot Configuration ==="
    else
        echo "============================================================"
        echo "   {{ ansible_distribution | upper }} WORKSTATION BUILDER - First Boot Configuration   "
        echo "============================================================"
    fi
}

function status_msg() {
    local msg="$1"
    if [ -n "$GUM" ]; then
        $GUM style --foreground 123 "➜ $msg" || echo "➜ $msg"
    else
        echo "➜ $msg"
    fi
}

function success_msg() {
    local msg="$1"
    if [ -n "$GUM" ]; then
        $GUM style --foreground 46 "✓ $msg" || echo "✓ $msg"
    else
        echo "✓ $msg"
    fi
}

# Clear screen for TUI
clear
banner
echo ""

# 0. Install yadm (user-level)
REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6 || echo "/home/$REAL_USER")

status_msg "Installing yadm for user $REAL_USER..."
if sudo -u "$REAL_USER" bash -c 'mkdir -p ~/.local/bin && curl -fLo ~/.local/bin/yadm https://github.com/yadm-dev/yadm/raw/master/yadm && chmod a+x ~/.local/bin/yadm'; then
    success_msg "yadm successfully installed in $REAL_HOME/.local/bin/yadm"
else
    echo "Warning: Failed to install yadm"
fi
echo ""

# 1. Set Graphical Target
status_msg "Checking display manager and setting target..."
if systemctl list-unit-files | grep -qE "^(gdm|lightdm|sddm)\.service"; then
    systemctl set-default graphical.target
    success_msg "Default target set to graphical.target"
fi

# 2. Configure Repository Priorities
status_msg "Configuring repository priorities..."
{% if ansible_distribution == 'Fedora' %}
dnf config-manager setopt \
    fedora.priority=0 \
    updates.priority=0 \
    cuda-fedora*.priority=80 \
    rpmfusion-*.priority=90 || true
{% else %}
dnf config-manager setopt \
    almalinux-baseos.priority=0 \
    almalinux-appstream.priority=0 \
    almalinux-crb.priority=0 \
    epel.priority=90 \
    cuda-el*.priority=80 || true
{% endif %}
success_msg "Repository priorities optimized"

# 3. Install Flatpaks (system-level)
{% set flatpak_ns = namespace(apps=[]) %}
{% for c in osbuild_components %}
{% if c in osbuild_component_defs and osbuild_component_defs[c].flatpaks is defined %}
{% set flatpak_ns.apps = flatpak_ns.apps + osbuild_component_defs[c].flatpaks %}
{% endif %}
{% endfor %}

{% if flatpak_ns.apps | length > 0 %}
status_msg "Installing component Flatpaks..."
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

{% for app in flatpak_ns.apps | unique %}
echo "Installing {{ app }}..."
flatpak install --system -y flathub {{ app }} || echo "Warning: Failed to install {{ app }}"
{% endfor %}
success_msg "Flatpak installation complete"
{% endif %}

# 4. Verify component installation
echo ""
status_msg "Final System Verification"
CHECK_TOOLS=("ansible" "git" "podman" "virt-install" "cockpit-bridge" "zsh" "nvidia-smi" "flatpak" "gum")
REPORTS=()

for tool in "${CHECK_TOOLS[@]}"; do
    if command -v "$tool" &>/dev/null; then
        REPORTS+=("✓ $tool is ready")
    else
        REPORTS+=("✗ $tool is MISSING")
    fi
done

if [ -n "$GUM" ]; then
    printf "%s\n" "${REPORTS[@]}" | $GUM style --foreground 250 --border rounded --padding "0 2" || printf "%s\n" "${REPORTS[@]}"
else
    printf "%s\n" "${REPORTS[@]}"
fi

echo ""
if [ -n "$GUM" ]; then
    $GUM style --foreground 46 --bold "Configuration Complete. Enjoy your new workstation!" || echo "Configuration Complete. Enjoy your new workstation!"
else
    echo "Configuration Complete. Enjoy your new workstation!"
fi
sleep 5

# Clean up first-boot files to prevent running on subsequent logins
if [ -f /usr/local/sbin/custom-first-boot ]; then
    mv /usr/local/sbin/custom-first-boot /usr/local/sbin/custom-first-boot-done
fi
if [ -f /usr/local/bin/custom-first-boot-launcher ]; then
    rm -f /usr/local/bin/custom-first-boot-launcher
fi
if [ -f /etc/xdg/autostart/custom-first-boot.desktop ]; then
    rm -f /etc/xdg/autostart/custom-first-boot.desktop
fi
