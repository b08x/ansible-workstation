# Managed by Ansible - b08x.llmops.dify role
# Environment file for Dify Docker Compose deployment

# Core service URLs
CONSOLE_API_URL={{ dify_console_api_url }}
SERVER_CONSOLE_API_URL=http://api:5001
CONSOLE_WEB_URL={{ dify_console_web_url }}
SERVICE_API_URL={{ dify_service_api_url }}
APP_API_URL={{ dify_app_api_url }}
APP_WEB_URL={{ dify_app_web_url }}
FILES_URL=http://{{ inventory_hostname }}

# Runtime and security
LANG=C.UTF-8
LC_ALL=C.UTF-8
PYTHONIOENCODING=utf-8
SECRET_KEY={{ dify_secret_key }}
INIT_PASSWORD={{ dify_init_password }}
DEPLOY_ENV={{ dify_deploy_env }}
CHECK_UPDATE_URL=https://updates.dify.ai
OPENAI_API_BASE=https://api.openai.com/v1
MIGRATION_ENABLED=true
FILES_ACCESS_TIMEOUT=300
ENABLE_COLLABORATION_MODE={{ dify_enable_collaboration_mode | lower }}

# Logging
LOG_LEVEL={{ dify_log_level }}
LOG_OUTPUT_FORMAT=text
LOG_FILE=/app/logs/server.log
LOG_FILE_MAX_SIZE=20
LOG_FILE_BACKUP_COUNT=5
LOG_DATEFORMAT=%Y-%m-%d %H:%M:%S
LOG_TZ=UTC
DEBUG=false
FLASK_DEBUG=false
DIFY_BIND_ADDRESS=0.0.0.0
DIFY_PORT=5001

# Database
DB_TYPE=postgresql
DB_USERNAME={{ dify_db_username }}
DB_PASSWORD={{ dify_db_password }}
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE={{ dify_db_database }}
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=3600
PGDATA=/var/lib/postgresql/data/pgdata

# Redis and Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD={{ dify_redis_password }}
REDIS_USE_SSL=false
CELERY_BROKER_URL=redis://:{{ dify_redis_password }}@redis:6379/1
CELERY_BACKEND=redis
BROKER_USE_SSL=false

# Web and app limits
WEB_API_CORS_ALLOW_ORIGINS=*
CONSOLE_CORS_ALLOW_ORIGINS=*
COOKIE_DOMAIN=
TEXT_GENERATION_TIMEOUT_MS=60000

# Storage and vector store
STORAGE_TYPE=opendal
OPENDAL_SCHEME=fs
OPENDAL_FS_ROOT=storage
VECTOR_STORE={{ dify_vector_store }}
VECTOR_INDEX_NAME_PREFIX=Vector_index
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY={{ dify_weaviate_api_key }}
WEAVIATE_GRPC_ENDPOINT=grpc://weaviate:50051
WEAVIATE_PERSISTENCE_DATA_PATH=/var/lib/weaviate
WEAVIATE_QUERY_DEFAULTS_LIMIT=25
WEAVIATE_AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=false
WEAVIATE_DEFAULT_VECTORIZER_MODULE=none
WEAVIATE_CLUSTER_HOSTNAME=node1
WEAVIATE_AUTHENTICATION_APIKEY_ENABLED=true
WEAVIATE_AUTHENTICATION_APIKEY_ALLOWED_KEYS={{ dify_weaviate_api_key }}
WEAVIATE_AUTHENTICATION_APIKEY_USERS=hello@dify.ai
WEAVIATE_AUTHORIZATION_ADMINLIST_ENABLED=true
WEAVIATE_AUTHORIZATION_ADMINLIST_USERS=hello@dify.ai

# pgvector vector store
PGVECTOR_HOST={{ dify_pgvector_host }}
PGVECTOR_PORT={{ dify_pgvector_port }}
PGVECTOR_USER={{ dify_pgvector_user }}
PGVECTOR_PASSWORD={{ dify_pgvector_password }}
PGVECTOR_DATABASE={{ dify_pgvector_database }}
PGVECTOR_MIN_CONNECTION={{ dify_pgvector_min_connection }}
PGVECTOR_MAX_CONNECTION={{ dify_pgvector_max_connection }}
PGVECTOR_PG_BIGM={{ dify_pgvector_pg_bigm | lower }}
PGVECTOR_PGUSER={{ dify_pgvector_user }}
PGVECTOR_POSTGRES_PASSWORD={{ dify_pgvector_password }}
PGVECTOR_POSTGRES_DB={{ dify_pgvector_database }}
PGVECTOR_PGDATA={{ dify_pgvector_pgdata }}
PGVECTOR_PG_BIGM_VERSION={{ dify_pgvector_pg_bigm_version }}

# Sandbox and SSRF proxy
CODE_EXECUTION_ENDPOINT=http://sandbox:8194
CODE_EXECUTION_API_KEY={{ dify_sandbox_api_key }}
SANDBOX_API_KEY={{ dify_sandbox_api_key }}
SANDBOX_GIN_MODE=release
SANDBOX_WORKER_TIMEOUT=15
SANDBOX_ENABLE_NETWORK=true
SANDBOX_HTTP_PROXY=http://ssrf_proxy:3128
SANDBOX_HTTPS_PROXY=http://ssrf_proxy:3128
SANDBOX_PORT=8194
SSRF_PROXY_HTTP_URL=http://ssrf_proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf_proxy:3128
SSRF_HTTP_PORT=3128
SSRF_COREDUMP_DIR=/var/spool/squid
SSRF_PROXY_ALLOW_PRIVATE_IPS={{ dify_ssrf_proxy_allow_private_ips }}

# Plugin daemon
DB_PLUGIN_DATABASE={{ dify_db_plugin_database }}
EXPOSE_PLUGIN_DAEMON_PORT=5002
PLUGIN_DAEMON_PORT=5002
PLUGIN_DAEMON_KEY={{ dify_plugin_daemon_key }}
PLUGIN_DAEMON_URL=http://plugin_daemon:5002
PLUGIN_MAX_PACKAGE_SIZE=52428800
PLUGIN_DIFY_INNER_API_KEY={{ dify_plugin_dify_inner_api_key }}
PLUGIN_DIFY_INNER_API_URL=http://api:5001
FORCE_VERIFYING_SIGNATURE=true
PLUGIN_DEBUGGING_HOST=0.0.0.0
PLUGIN_DEBUGGING_PORT={{ dify_plugin_debugging_port }}
EXPOSE_PLUGIN_DEBUGGING_HOST=localhost
EXPOSE_PLUGIN_DEBUGGING_PORT={{ dify_plugin_debugging_port }}
PLUGIN_STORAGE_TYPE=local
PLUGIN_STORAGE_LOCAL_ROOT=/app/storage
PLUGIN_WORKING_PATH=/app/storage/cwd
PLUGIN_INSTALLED_PATH=plugin
PLUGIN_PACKAGE_CACHE_PATH=plugin_packages
PLUGIN_MEDIA_CACHE_PATH=assets
MARKETPLACE_ENABLED=true
MARKETPLACE_API_URL=https://marketplace.dify.ai
MARKETPLACE_URL=https://marketplace.dify.ai

# Agent backend
AGENT_BACKEND_BASE_URL=http://agent_backend:5050
DIFY_AGENT_API_TOKEN={{ dify_agent_api_token }}
DIFY_AGENT_RUNTIME_BACKEND=local
DIFY_AGENT_LOCAL_SANDBOX_ENDPOINT=http://local_sandbox:5004
DIFY_AGENT_STUB_API_BASE_URL=http://agent_backend:5050/agent-stub
DIFY_AGENT_SANDBOX_FILES_BASE_URL=http://api:5001
DIFY_AGENT_SERVER_SECRET_KEY={{ dify_agent_server_secret_key }}

# Nginx
NGINX_SERVER_NAME={{ dify_nginx_server_name }}
NGINX_HTTPS_ENABLED={{ dify_nginx_https_enabled | lower }}
NGINX_PORT=80
NGINX_SSL_PORT=443
EXPOSE_NGINX_PORT={{ dify_nginx_port }}
EXPOSE_NGINX_SSL_PORT={{ dify_nginx_ssl_port }}
NGINX_SSL_CERT_FILENAME=dify.crt
NGINX_SSL_CERT_KEY_FILENAME=dify.key
NGINX_SSL_PROTOCOLS=TLSv1.2 TLSv1.3
NGINX_WORKER_PROCESSES=auto
NGINX_CLIENT_MAX_BODY_SIZE=100M
NGINX_KEEPALIVE_TIMEOUT=65
NGINX_PROXY_READ_TIMEOUT=3600s
NGINX_PROXY_SEND_TIMEOUT=3600s
NGINX_SOCKET_IO_UPSTREAM=api_websocket:5001

# Compose profiles
COMPOSE_PROFILES={{ dify_vector_store }},postgresql{% if dify_enable_collaboration_mode %},collaboration{% endif %}
