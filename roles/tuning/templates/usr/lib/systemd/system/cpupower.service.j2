[Unit]
Description=Apply cpupower configuration
ConditionVirtualization=!container

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/cpupower.conf
{% if ansible_distribution == "Fedora" %}
ExecStart=/usr/libexec/cpupower
{% elif ansible_distribution in ["AlmaLinux", "Rocky"] %}
{# /usr/bin/cpupower on both EL clones: verified inside rockylinux:9 and
   rockylinux:10 containers (provided by kernel-tools, 2026-10-01). #}
ExecStart=/usr/bin/cpupower
{% endif %}
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target