# Managed by Ansible roles/common (CIS Level 2 Workstation Tailoring)
# Bounded auditd log rotation: {{ common_auditd_max_log_file | default(32) }} MB x {{ common_auditd_num_logs | default(16) }} = 512 MB total cap

local_events = yes
write_logs = yes
log_file = /var/log/audit/audit.log
log_group = root
log_format = ENRICHED
flush = INCREMENTAL_ASYNC
freq = 50
max_log_file = {{ common_auditd_max_log_file | default(32) }}
num_logs = {{ common_auditd_num_logs | default(16) }}
priority_boost = 4
name_format = NONE
max_log_file_action = ROTATE
space_left = {{ common_auditd_space_left | default(75) }}
space_left_action = SYSLOG
verify_email = yes
action_mail_acct = root
admin_space_left = {{ common_auditd_admin_space_left | default(50) }}
admin_space_left_action = ROTATE
disk_full_action = ROTATE
disk_error_action = SYSLOG
