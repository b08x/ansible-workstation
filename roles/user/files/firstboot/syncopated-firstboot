# --- output ------------------------------------------------------------------

have_gum() {
  command -v gum >/dev/null 2>&1
}

# style COLOR LINE... : print lines in a foreground color (hex or 256-color).
style() {
  local color=$1
  shift
  if have_gum; then
    gum style --foreground "$color" "$@"
  else
    printf '%s\n' "$@"
  fi
}

info() { style "${VIOLET_LIGHT[0]}" "➜ $*"; }
ok() { style "${EMBER[0]}" "✓ $*"; }
warn() { style '#E0A030' "! $*" >&2; }
err() { style '#D03030' "✗ $*" >&2; }

# fg HEX INDEX : print the SGR sequence for a foreground color. Uses 24-bit
# color when the terminal reports it in COLORTERM, else the 256-color index.
fg() {
  local hex=${1#\#}
  if [[ ${COLORTERM:-} == truecolor || ${COLORTERM:-} == 24bit ]]; then
    printf '\e[38;2;%d;%d;%dm' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
  else
    printf '\e[38;5;%sm' "$2"
  fi
}

# os_field KEY : print the value of KEY from os-release, without quotes.
os_field() {
  local key=$1 line value
  [[ -r $OS_RELEASE ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == "$key="* ]] || continue
    value=${line#*=}
    value=${value#[\"\']}
    value=${value%[\"\']}
    printf '%s\n' "$value"
    return 0
  done <"$OS_RELEASE"
  return 1
}

os_label() {
  local name version
  name=$(os_field NAME) || name=Linux
  version=$(os_field VERSION_ID) || version=
  printf '%s\n' "$name${version:+ $version}"
}

restore_terminal() {
  [[ -t 1 ]] || return 0
  tput sgr0 2>/dev/null
  tput cnorm 2>/dev/null
  return 0
}

# paint_art WIDTH : fill ART_PAINTED with the ART lines cut to WIDTH columns,
# each glyph colored by region (mark or wordmark) and weight (dim or full).
paint_art() {
  local width=$1 row col line ch tone prev out
  local -A seq=(
    [mark]=$(fg "${VIOLET[@]}") [mark_dim]=$(fg "${VIOLET_DIM[@]}")
    [word]=$(fg "${EMBER[@]}") [word_dim]=$(fg "${EMBER_DIM[@]}")
  )
  ART_PAINTED=()
  for ((row = 0; row < ${#ART[@]}; row++)); do
    line=${ART[row]:0:width} out='' prev=''
    for ((col = 0; col < ${#line}; col++)); do
      ch=${line:col:1}
      if [[ $ch == ' ' ]]; then
        out+=' '
        continue
      fi
      # The logo image draws "{1{}" on the mark's second-to-last row in ember.
      if ((col < ART_SPLIT)) && ! ((row == 19 && col >= 10 && col <= 13)); then
        tone=mark
      else
        tone=word
      fi
      [[ $ART_DIM_GLYPHS == *"$ch"* ]] && tone+=_dim
      [[ $tone == "$prev" ]] || out+=${seq[$tone]}
      prev=$tone
      out+=$ch
    done
    ART_PAINTED+=("$out"$'\e[0m')
  done
}

# Full-screen splash: the art centered, revealed row by row, then held with a
# pulsing "press enter to begin" until Enter. A terminal narrower than the art
# shows the mark only. Prints the art uncolored and returns at once when stdin
# or stdout is not a terminal. SYNCOPATED_NO_ANIM=1 skips the reveal delay.
splash() {
  if [[ ! -t 0 || ! -t 1 ]] || ! tput cup 0 0 >/dev/null 2>&1; then
    printf '%s\n' "${ART[@]}"
    return 0
  fi
  local rows cols width=0 height=${#ART[@]} line row top left prompt='press enter to begin' prow pcol lit=1 rc
  rows=$(tput lines)
  cols=$(tput cols)
  for line in "${ART[@]}"; do
    ((${#line} > width)) && width=${#line}
  done
  ((width > cols)) && width=$((ART_SPLIT < cols ? ART_SPLIT : cols))
  paint_art "$width"

  top=$(((rows - height - 2) / 2))
  ((top < 0)) && top=0
  left=$(((cols - width) / 2))
  prow=$((top + height + 2 < rows ? top + height + 2 : rows - 1))
  pcol=$(((cols - ${#prompt}) / 2))
  ((pcol < 0)) && pcol=0

  clear
  tput civis 2>/dev/null
  for ((row = 0; row < height; row++)); do
    tput cup $((top + row)) "$left"
    printf '%s' "${ART_PAINTED[row]}"
    [[ -n ${SYNCOPATED_NO_ANIM:-} ]] || sleep 0.03
  done
  while :; do
    tput cup "$prow" "$pcol"
    if ((lit)); then fg "${EMBER[@]}"; else fg "${EMBER_DIM[@]}"; fi
    printf '%s\e[0m' "$prompt"
    lit=$((1 - lit))
    read -r -s -t 0.8 _
    rc=$?
    # 0 = Enter, >128 = timeout (pulse again), anything else = EOF/error.
    ((rc > 128)) || break
  done
  clear
  tput cnorm 2>/dev/null
}

banner() {
  local label title=${1:-First login setup}
  label=$(os_label)
  if have_gum; then
    gum style --border double --border-foreground "${VIOLET[0]}" --foreground "${EMBER[0]}" \
      --align center --width 60 --padding "1 2" \
      "SYNCOPATED" "$label" "$title"
  else
    printf '%s\n' \
      "============================================================" \
      "  SYNCOPATED  |  $label  |  $title" \
      "============================================================"
  fi
}

# step_lines STEP... : append one "icon step (state)" line per step to LINES.
step_lines() {
  local step state icon
  for step in "$@"; do
    state=${STEP_STATE[$step]:-pending}
    case $state in
      ok) icon='✓' ;;
      failed) icon='✗' ;;
      skipped) icon='-' ;;
      *) icon='·' ;;
    esac
    LINES+=("  $icon $step ($state)")
  done
}

# draw_steps : print the active step list (SECTION_TITLE + ACTIVE_STEPS).
draw_steps() {
  local LINES=("$SECTION_TITLE")
  step_lines "${ACTIVE_STEPS[@]}"
  local lines=("${LINES[@]}")
  if have_gum; then
    gum style --border rounded --border-foreground "${VIOLET_DIM[0]}" --padding "0 2" "${lines[@]}"
  else
    printf '  %s\n' "${lines[@]}"
  fi
}

# --- prompts -------------------------------------------------------------------

# choose HEADER OPTION... : print the selected option. Fails on cancel/EOF.
choose() {
  local header=$1 reply opt i
  shift
  if have_gum; then
    gum choose --header "$header" "$@"
    return
  fi
  printf '%s\n' "$header" >&2
  for ((i = 1; i <= $#; i++)); do
    printf '  %d) %s\n' "$i" "${!i}" >&2
  done
  while :; do
    read -r -p "Choose [1-$#]: " reply || return 1
    if [[ $reply =~ ^[0-9]+$ ]] && ((reply >= 1 && reply <= $#)); then
      printf '%s\n' "${!reply}"
      return 0
    fi
    for opt in "$@"; do
      [[ $reply == "$opt" ]] && { printf '%s\n' "$opt"; return 0; }
    done
    printf 'Enter a number from 1 to %d.\n' "$#" >&2
  done
}

# --- markers ------------------------------------------------------------------

write_stage2_marker() {
  mkdir -p "$STATE_DIR" && date -Is >"$STAGE2_MARKER"
}

write_stage2_declined_marker() {
  mkdir -p "$STATE_DIR" && printf 'declined %s\n' "$(date -Is)" >"$STAGE2_MARKER"
}

# stage2_done_content : print the stage-2 (or legacy) marker content, or fail.
stage2_done_content() {
  local marker content
  for marker in "$STAGE2_MARKER" "$LEGACY_MARKER"; do
    if [[ -f $marker ]]; then
      content=$(<"$marker")
      printf '%s\n' "$content"
      return 0
    fi
  done
  return 1
}

# --- steps ---------------------------------------------------------------------

acquire_lock() {
  command -v flock >/dev/null 2>&1 || return 0
  local dir=${XDG_RUNTIME_DIR:-$STATE_DIR}
  mkdir -p "$dir" 2>/dev/null || return 0
  exec {LOCK_FD}>"$dir/syncopated-firstboot.lock" || return 0
  flock -n "$LOCK_FD"
}

ensure_user_path() {
  [[ -n ${HOME:-} ]] || return 0
  local dir
  for dir in "$HOME/.bun/bin" "$HOME/go/bin" "$HOME/.cargo/bin" "$HOME/.local/bin" "${RBENV_ROOT:-$HOME/.rbenv}/shims"; do
    case ":$PATH:" in
      *":$dir:"*) ;;
      *) PATH="$dir:$PATH" ;;
    esac
  done
  export PATH
}

wait_for_network() {
  command -v nm-online >/dev/null 2>&1 || return 0
  info "Waiting for the network (up to 30 s)"
  nm-online -q -t 30 || warn "The network is not online yet."
}

# Install yadm to ~/.local/bin when it is not on PATH. Returns 0 when yadm is
# available afterwards. On failure the manual download command is printed.
install_yadm() {
  command -v yadm >/dev/null 2>&1 && return 0
  local dest=$HOME/.local/bin/yadm
  info "Installing yadm to $dest"
  if mkdir -p "${dest%/*}" && curl -fsSL -o "$dest" "$YADM_URL" && chmod 0755 "$dest"; then
    ok "yadm installed"
    return 0
  fi
  rm -f "$dest"
  warn "Could not download yadm from $YADM_URL. Run later:"
  printf '  %s\n' \
    "mkdir -p ~/.local/bin && curl -fsSL -o ~/.local/bin/yadm $YADM_URL && chmod 0755 ~/.local/bin/yadm"
  return 1
}

# Print the command stage 2 runs for the dotfiles clone. Only this one
# command: yadm clone --bootstrap delegates to yadm's own orchestrator.
print_stage2_commands() {
  info "Dotfiles (yadm): this command clones your dotfiles and runs yadm bootstrap."
  printf '  %s\n' \
    "yadm clone --bootstrap $DOTFILES_URL"
}

# Apply every available package update. dnf prints "Nothing to do." when
# there is nothing to install; any other successful run installed something.
update_system() {
  if ! command -v dnf >/dev/null 2>&1; then
    info "dnf not found; system update skipped."
    return "$RC_SKIPPED"
  fi
  local log rc
  log=$(mktemp) || return "$RC_FAILED"
  info "Updating the system: sudo dnf -y upgrade --refresh"
  sudo dnf -y upgrade --refresh 2>&1 | tee "$log"
  rc=${PIPESTATUS[0]}
  if ((rc != 0)); then
    rm -f "$log"
    err "System update failed (dnf exit $rc). Run later: sudo dnf upgrade --refresh"
    return "$RC_FAILED"
  fi
  if grep -q '^Nothing to do\.' "$log"; then
    ok "System is up to date"
  else
    UPDATES_INSTALLED=1
    ok "System updated"
  fi
  rm -f "$log"
  return "$RC_OK"
}

# Set up deterministic language toolchains: rbenv global Ruby, uv-managed
# Python, pipx, Bun. Runs as the logged-in user. Skipped when the script is absent.
setup_toolchains() {
  if [[ ! -x /usr/local/bin/syncopated-toolchains ]]; then
    info "syncopated-toolchains not found; toolchain setup skipped."
    return "$RC_SKIPPED"
  fi
  info "Setting up language toolchains (Ruby, Python, Bun)…"
  if /usr/local/bin/syncopated-toolchains; then
    ok "Toolchains ready"
    return "$RC_OK"
  fi
  warn "Toolchain setup had errors. Run later: /usr/local/bin/syncopated-toolchains"
  return "$RC_FAILED"
}

# Run ansible-pull as root with the repository and arguments from
# $ANSIBLE_PULL_CONF. Skipped when the configuration is incomplete or
# ansible-pull is not installed.
run_ansible_pull() {
  local ANSIBLE_PULL_REPO='' ANSIBLE_PULL_ARGS=() rc
  # shellcheck source=/dev/null
  if ! source "$ANSIBLE_PULL_CONF"; then
    err "Could not read $ANSIBLE_PULL_CONF."
    return "$RC_FAILED"
  fi
  if [[ -z $ANSIBLE_PULL_REPO ]] || ((${#ANSIBLE_PULL_ARGS[@]} == 0)); then
    info "ansible-pull repository or arguments not set in $ANSIBLE_PULL_CONF; skipped."
    return "$RC_SKIPPED"
  fi
  if ! command -v ansible-pull >/dev/null 2>&1; then
    warn "ansible-pull not found; install ansible-core in the image. Skipped."
    return "$RC_SKIPPED"
  fi
  info "Running: sudo ansible-pull -U $ANSIBLE_PULL_REPO ${ANSIBLE_PULL_ARGS[*]}"
  sudo ansible-pull -U "$ANSIBLE_PULL_REPO" "${ANSIBLE_PULL_ARGS[@]}"
  rc=$?
  if ((rc != 0)); then
    err "ansible-pull failed (exit $rc). Run later: sudo ansible-pull -U $ANSIBLE_PULL_REPO ${ANSIBLE_PULL_ARGS[*]}"
    return "$RC_FAILED"
  fi
  PULL_SUCCEEDED=1
  ok "ansible-pull finished"
  return "$RC_OK"
}

# After a successful ansible-pull run, assert the machine pull marker
# ($MACHINE_MARKER, written by the workstation playbook) exists. A missing
# marker means the pull used a partial tag selection; warn and continue.
verify_pull_marker() {
  if ! ((PULL_SUCCEEDED)); then
    info "No successful ansible-pull run; the pull marker was not verified."
    return "$RC_SKIPPED"
  fi
  if [[ -f $MACHINE_MARKER ]]; then
    ok "Pull marker present: $MACHINE_MARKER"
    return "$RC_OK"
  fi
  warn "ansible-pull reported success but $MACHINE_MARKER is missing (partial tag run?). A full pull writes it."
  return "$RC_OK"
}

# Offer a reboot after installed updates. Returns 0 only when the reboot was
# started. No marker is written, so the upstream hook stays silent anyway and
# stage 2 takes over at the first graphical login.
offer_reboot() {
  local action
  action=$(choose "Updates were installed. Reboot now? The graphical stage opens at the next login." \
    "Reboot now" "Continue setup") || action="Continue setup"
  [[ $action == "Reboot now" ]] || return 1
  info "Rebooting. Stage 2 (yadm dotfiles) opens at the first graphical login."
  if ! sudo systemctl reboot; then
    warn "Could not reboot (sudo failed). Continuing setup."
    return 1
  fi
}

# Boot to the display manager when one is installed.
set_graphical_target() {
  local units
  units=$(systemctl list-unit-files --no-legend gdm.service lightdm.service sddm.service 2>/dev/null)
  if [[ -z $units ]]; then
    info "No display manager installed; default target unchanged."
    return "$RC_OK"
  fi
  if [[ $(systemctl get-default 2>/dev/null) == graphical.target ]]; then
    ok "Default target is already graphical.target"
    return "$RC_OK"
  fi
  if sudo systemctl set-default graphical.target; then
    ok "Default target set to graphical.target"
  else
    warn "Could not set graphical.target (sudo failed). Run: sudo systemctl set-default graphical.target"
  fi
  return "$RC_OK"
}

prompt_switch_graphical() {
  local units
  units=$(systemctl list-unit-files --no-legend gdm.service lightdm.service sddm.service 2>/dev/null)
  [[ -n $units ]] || return 0

  local action
  action=$(choose "Default boot target is now graphical.target. Switch to graphical desktop now?" \
    "Start graphical desktop" "Stay in console") || action="Stay in console"
  if [[ $action == "Start graphical desktop" ]]; then
    info "Switching to graphical desktop: sudo systemctl isolate graphical.target"
    if ! sudo systemctl isolate graphical.target; then
      warn "Could not switch to graphical desktop (sudo failed)."
    fi
  fi
}

# run_step NAME COMMAND... : run a step, record its state, redraw the list.
run_step() {
  local name=$1 rc
  shift
  "$@"
  rc=$?
  case $rc in
    "$RC_OK") STEP_STATE[$name]=ok ;;
    "$RC_SKIPPED") STEP_STATE[$name]=skipped ;;
    *) STEP_STATE[$name]=failed ;;
  esac
  draw_steps
  return "$rc"
}

report() {
  local tool rows=()
  for tool in "${CHECK_TOOLS[@]}"; do
    if command -v "$tool" >/dev/null 2>&1; then
      rows+=("✓ ready    $tool")
    else
      rows+=("✗ missing  $tool")
    fi
  done
  if have_gum; then
    gum style --border rounded --border-foreground "${EMBER_DIM[0]}" --padding "0 2" "Tool check" "${rows[@]}"
  else
    printf '%s\n' "Tool check" "${rows[@]/#/  }"
  fi
}

# --- stage 2: delegated yadm setup ---------------------------------------------

# Clone the dotfiles with yadm and run its bootstrap orchestrator. Stage 2
# delegates: drift preflight and the bootstrap step registry are yadm's own.
clone_and_bootstrap() {
  if ! command -v yadm >/dev/null 2>&1; then
    err "yadm is not available; stage 2 cannot clone the dotfiles."
    return "$RC_FAILED"
  fi
  info "Running: yadm clone --bootstrap $DOTFILES_URL"
  if yadm clone --bootstrap "$DOTFILES_URL"; then
    ok "yadm clone --bootstrap finished"
    return "$RC_OK"
  fi
  local rc=$?
  err "yadm clone --bootstrap failed (exit $rc)."
  return "$RC_FAILED"
}

# Write the stage-2 marker and the completion notice. Registered as the
# "report" step so the registry shows it.
stage2_report() {
  write_stage2_marker
  ok "Dotfiles setup complete. Stage 2 will not open at login again. Run syncopated-firstboot --stage 2 to show the offer anytime."
  return "$RC_OK"
}

# stage2_failure_retry MESSAGE : after a failed step offer Retry / Show
# commands / Abort (the bootstrap failure-menu shape). Returns 0 to retry,
# 1 to give up (printing the commands first when requested).
stage2_failure_retry() {
  local action
  if ! action=$(choose "$1" "Retry" "Show commands" "Abort"); then
    return 1
  fi
  case $action in
    Retry) return 0 ;;
    "Show commands")
      print_stage2_commands
      return 1
      ;;
    *) return 1 ;;
  esac
}

# Run the delegated yadm setup: install yadm, clone+bootstrap, report. A
# failed step offers Retry / Show commands / Abort.
stage2_run_setup() {
  local rc
  while :; do
    run_step yadm install_yadm
    rc=$?
    if ((rc != 0)); then
      stage2_failure_retry "yadm install failed" && continue
      return "$RC_FAILED"
    fi
    run_step clone+bootstrap clone_and_bootstrap
    rc=$?
    if ((rc != 0)); then
      stage2_failure_retry "yadm clone --bootstrap failed" && continue
      return "$RC_FAILED"
    fi
    break
  done
  run_step report stage2_report
  return "$RC_OK"
}

# --- stages ---------------------------------------------------------------------

stage1() {
  splash
  banner
  if [[ -f $MACHINE_MARKER ]]; then
    info "System convergence completed before ($(<"$MACHINE_MARKER")). Running stage 1 again."
  fi
  draw_steps

  # System setup: wait for the network, then run the step registry.
  wait_for_network
  run_step update update_system
  run_step toolchains setup_toolchains
  ((ANSIBLE_PULL_ENABLED)) && run_step ansible_pull run_ansible_pull
  run_step verify_pull_marker verify_pull_marker
  run_step target set_graphical_target
  if ((UPDATES_INSTALLED)) && offer_reboot; then
    return 0
  fi
  report
  ok "Stage 1 complete. Stage 2 (yadm dotfiles) opens at the first graphical login, or run: syncopated-firstboot --stage 2"
  prompt_switch_graphical
}

stage2() {
  local action previous
  SECTION_TITLE='Yadm'
  ACTIVE_STEPS=(yadm clone+bootstrap report)
  splash
  banner "Dotfiles setup"
  if previous=$(stage2_done_content); then
    info "Yadm setup was completed before ($previous). Showing the offer again."
  fi
  draw_steps

  if ! action=$(choose "Set up your dotfiles with yadm?" \
    "Run yadm setup now" "Show commands" "Skip for this machine"); then
    info "No choice made. The offer stays available; run syncopated-firstboot --stage 2 to see it again."
    return "$RC_SKIPPED"
  fi
  case $action in
    "Run yadm setup now")
      stage2_run_setup
      return $?
      ;;
    "Show commands")
      install_yadm
      print_stage2_commands
      write_stage2_marker
      ok "Setup complete. Stage 2 will not open at login again. Run syncopated-firstboot --stage 2 to show the offer anytime."
      return "$RC_OK"
      ;;
    *) # Skip for this machine.
      write_stage2_declined_marker
      info "Skipped. Stage 2 will not open at login again. Run syncopated-firstboot --stage 2 to show the offer anytime."
      return "$RC_SKIPPED"
      ;;
  esac
}

summary() {
  local previous
  splash
  banner
  if [[ -f $MACHINE_MARKER ]]; then
    info "Stage 1 (system convergence) completed before ($(<"$MACHINE_MARKER"))."
  else
    info "Stage 1 (system convergence) is not done yet. Run: syncopated-firstboot --stage 1"
  fi
  if previous=$(stage2_done_content); then
    info "Stage 2 (dotfiles) completed before ($previous)."
  else
    info "Stage 2 (dotfiles) has not run yet. Run: syncopated-firstboot --stage 2"
  fi
  print_stage2_commands
}

# --- argument parsing -----------------------------------------------------------

# stage_arg ARGS... : print the stage from --stage 1|2 / --stage=1|2 / -1 / -2
# and return 0; print nothing and return 1 when no stage was requested;
# return 2 (with a message on stderr) for an invalid stage value.
stage_arg() {
  local i arg next
  for ((i = 1; i <= $#; i++)); do
    arg=${!i}
    case $arg in
      -1) printf '1\n'; return 0 ;;
      -2) printf '2\n'; return 0 ;;
      --stage=1) printf '1\n'; return 0 ;;
      --stage=2) printf '2\n'; return 0 ;;
      --stage)
        next=$((i + 1))
        if ((next > $#)); then
          printf 'syncopated-firstboot: --stage needs a value (1 or 2)\n' >&2
          return 2
        fi
        case ${!next} in
          1) printf '1\n'; return 0 ;;
          2) printf '2\n'; return 0 ;;
          *)
            printf 'syncopated-firstboot: invalid stage: %s (use 1 or 2)\n' "${!next}" >&2
            return 2
            ;;
        esac
        ;;
    esac
  done
  return 1
}

# detect_stage : print 1, 2, or 0 (summary) from the session and markers.
# The automatic triggers never rely on this; they pass the stage explicitly.
detect_stage() {
  if [[ -z ${DISPLAY:-} && -z ${WAYLAND_DISPLAY:-} ]] && [[ ! -f $MACHINE_MARKER ]]; then
    printf '1\n'
  elif [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} ]] && ! stage2_done_content >/dev/null; then
    printf '2\n'
  else
    printf '0\n'
  fi
}

main() {
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    err "Run syncopated-firstboot as your own user, not as root."
    return 1
  fi
  if ! acquire_lock; then
    warn "syncopated-firstboot is already running."
    return 0
  fi
  ensure_user_path
  trap restore_terminal EXIT

  local stage rc
  stage=$(stage_arg "$@")
  rc=$?
  if ((rc == 2)); then
    return 1
  fi
  if [[ -z $stage ]]; then
    stage=$(detect_stage)
  fi
  case $stage in
    1) stage1 ;;
    2) stage2 ;;
    *) summary ;;
  esac
  return $?
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  set -uo pipefail
  main "$@"
  rc=$?
  if [[ -n ${SYNCOPATED_PAUSE_ON_EXIT:-} ]] && [[ -t 0 ]]; then
    read -rp 'Press Enter to close…' _
  fi
  exit "$rc"
fi
