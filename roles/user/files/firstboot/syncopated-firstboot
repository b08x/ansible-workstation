#!/usr/bin/env bash
# syncopated-firstboot: two-stage first-login convergence, run as the
# logged-in user.
#   Stage 1 (console login, fired by /etc/profile.d/syncopated-firstboot.sh):
#             wait for network, update the system with dnf, set up language
#             toolchains (rbenv global Ruby, uv-managed Python, pipx), run
#             ansible-pull when the image carries an ansible-pull
#             configuration, verify the machine pull marker, set the default
#             boot target, offer a reboot when updates were installed, report
#             installed tools. Stage 1 writes NO stage-2 marker.
#   Stage 2 (graphical login, fired by the XDG autostart launcher): offers to
#             run `yadm clone --bootstrap $DOTFILES_URL`. Stage 2 delegates
#             to yadm's own bootstrap orchestrator (drift preflight, step
#             registry, retry/skip/abort); it never reimplements the
#             bootstrap steps. On completion (or an explicit Skip) a per-user
#             stage-2 marker silences the autostart trigger.
#   No argument: mode detection — no graphical session and no machine pull
#             marker means stage 1; a graphical session with stage 2 not
#             done means stage 2; otherwise a summary splash (status of both
#             stages + the commands).
#
# Markers:
#   ${HOME:-/home/<user>}/.initial-firstboot (SYNCOPATED_FIRSTBOOT_MACHINE_MARKER):
#             machine-level pull marker, 0644 root:root with an ISO-8601
#             timestamp, written ONCE by the workstation ansible pull after a
#             full-tag run. It lives in the primary user's home on purpose:
#             root's $HOME and /root are not readable by the non-root console
#             user (stock installs /root is 0550 root:root), so a /root marker
#             would be unstat-able and stage 1 would re-fire at every console
#             login on a converged machine. Stage 1 and the profile hook only
#             test -f it (plain, no sudo).
#   $STATE_DIR/firstboot-stage2.done (SYNCOPATED_STAGE2_MARKER):
#             per-user stage-2 completion or declination. Gates only the
#             XDG autostart trigger, never a by-name run.
#   $STATE_DIR/firstboot.done:
#             legacy marker from the single-stage splash. Read-compat only:
#             its existence counts as stage 2 complete (silent migration).
#
# Markers gate only the automatic triggers (profile hook, XDG autostart).
# Running this script by name always shows the flow for the requested stage.
#
# Overrides (used by the bats tests): SYNCOPATED_OS_RELEASE,
# SYNCOPATED_YADM_URL, SYNCOPATED_DOTFILES_URL, SYNCOPATED_CHECK_TOOLS,
# SYNCOPATED_ANSIBLE_PULL_CONF (path of the ansible-pull configuration),
# SYNCOPATED_FIRSTBOOT_MACHINE_MARKER / SYNCOPATED_STAGE2_MARKER (marker
# paths), SYNCOPATED_NO_ANIM=1 (skip the splash reveal delay),
# SYNCOPATED_PAUSE_ON_EXIT=1 (set by the launcher: wait for Enter before
# exiting).

OS_RELEASE=${SYNCOPATED_OS_RELEASE:-/etc/os-release}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/syncopated
LEGACY_MARKER=$STATE_DIR/firstboot.done
STAGE2_MARKER=${SYNCOPATED_STAGE2_MARKER:-$STATE_DIR/firstboot-stage2.done}
MACHINE_MARKER=${SYNCOPATED_FIRSTBOOT_MACHINE_MARKER:-${HOME:-/home/$(id -un)}/.initial-firstboot}
YADM_URL=${SYNCOPATED_YADM_URL:-https://github.com/yadm-dev/yadm/raw/master/yadm}
DOTFILES_URL=${SYNCOPATED_DOTFILES_URL:-https://github.com/b08x/dots.git}
# Written into the image when osbuild_ansible_pull_repo and
# osbuild_ansible_pull_args are set; defines ANSIBLE_PULL_REPO (string) and
# ANSIBLE_PULL_ARGS (array). Without the file there is no ansible_pull step.
ANSIBLE_PULL_CONF=${SYNCOPATED_ANSIBLE_PULL_CONF:-/etc/syncopated-ansible-pull.conf}
read -r -a CHECK_TOOLS <<<"${SYNCOPATED_CHECK_TOOLS:-git yadm gum ansible podman zsh flatpak nvidia-smi ruby uv rbenv bun}"

# Step return codes.
RC_OK=0
RC_FAILED=1
RC_SKIPPED=2

SYSTEM_STEPS=(update toolchains verify_pull_marker target)
ANSIBLE_PULL_ENABLED=0
if [[ -r $ANSIBLE_PULL_CONF ]]; then
  ANSIBLE_PULL_ENABLED=1
  SYSTEM_STEPS=(update toolchains ansible_pull verify_pull_marker target)
fi
# Set by update_system when dnf installed or upgraded at least one package.
UPDATES_INSTALLED=0
# Set by run_ansible_pull: a completed (successful) pull run happened.
PULL_SUCCEEDED=0
declare -A STEP_STATE=()

# Step list drawn by draw_steps: a section title and the active step names.
SECTION_TITLE=System
ACTIVE_STEPS=("${SYSTEM_STEPS[@]}")

# Brand palette, sampled from the Syncopated logo: a violet mark and an ember
# wordmark, each with a dim tone for the light glyphs. Each entry is
# (hex for gum and 24-bit terminals, 256-color index for other terminals).
VIOLET=('#7B4FE0' 98)
VIOLET_DIM=('#4B3A8C' 60)
VIOLET_LIGHT=('#A98BF0' 141)
EMBER=('#D2601A' 166)
EMBER_DIM=('#7A3A1C' 94)

# Theme gum's prompts with the palette. GUM_* values already set by the user win.
export GUM_CHOOSE_HEADER_FOREGROUND=${GUM_CHOOSE_HEADER_FOREGROUND:-${VIOLET_LIGHT[0]}}
export GUM_CHOOSE_CURSOR_FOREGROUND=${GUM_CHOOSE_CURSOR_FOREGROUND:-${EMBER[0]}}
export GUM_CHOOSE_SELECTED_FOREGROUND=${GUM_CHOOSE_SELECTED_FOREGROUND:-${EMBER[0]}}

